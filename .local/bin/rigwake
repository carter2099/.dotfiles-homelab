#!/bin/bash
# rigwake — wake the dual-boot rig and report the resumed OS.
set -euo pipefail

RIG_MAC="${GAMING_RIG_MAC:-00:D8:61:39:52:71}"
WAIT="${1:-120}"
SSH_OPTIONS=(
    -o BatchMode=yes
    -o ConnectTimeout=2
    -o ConnectionAttempts=1
    -o ControlMaster=no
    -o ControlPath=none
    -o StrictHostKeyChecking=yes
)

echo "Sending WoL to $RIG_MAC..."
wakeonlan "$RIG_MAC"

echo "Waiting up to ${WAIT}s for a pinned OS-specific SSH host..."
for ((second = 1; second <= WAIT; second++)); do
    if ssh "${SSH_OPTIONS[@]}" gamingrig-linux "echo ready" 2>/dev/null | grep -q ready; then
        echo "Rig is online in Linux (${second}s)."
        exit 0
    fi
    if ssh "${SSH_OPTIONS[@]}" gamingrig-windows "echo ready" 2>/dev/null | grep -q ready; then
        echo "Rig is online in Windows (${second}s)."
        exit 0
    fi
    sleep 1
done

echo "Timed out after ${WAIT}s — neither pinned OS SSH host came online." >&2
exit 1
