#!/bin/bash
# rigsleep — put an online Windows gaming session to sleep.
set -euo pipefail

echo "Sending sleep signal to the pinned Windows host..."
ssh \
    -o BatchMode=yes \
    -o ConnectTimeout=5 \
    -o ControlMaster=no \
    -o ControlPath=none \
    -o StrictHostKeyChecking=yes \
    gamingrig-windows \
    'powershell.exe -NoProfile -NonInteractive -Command "Start-Process rundll32.exe -ArgumentList ''powrprof.dll,SetSuspendState 0,1,0''"' \
    2>/dev/null && rc=$? || rc=$?

if [[ "$rc" -eq 0 || "$rc" -eq 255 ]]; then
    echo "Windows sleep command sent."
    exit 0
fi

echo "Windows sleep command failed with code $rc." >&2
exit "$rc"
