# Homelab SSH hosts

Host gamingrig gamingrig-linux
    HostName 192.168.4.103
    HostKeyAlias gamingrig-linux
    User carte
    IdentityFile ~/.ssh/id_ed25519
    # Multiplexing: keep Linux and Windows control sockets distinct.
    ControlMaster auto
    ControlPath ~/.ssh/controlmasters/%r@%k:%p
    ControlPersist 5m

Host gamingrig-windows
    HostName 192.168.4.103
    HostKeyAlias gamingrig-windows
    User carte
    IdentityFile ~/.ssh/id_ed25519
    ControlMaster auto
    ControlPath ~/.ssh/controlmasters/%r@%k:%p
    ControlPersist 5m
