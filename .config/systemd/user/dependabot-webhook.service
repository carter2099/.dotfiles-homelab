[Unit]
Description=Dependabot webhook receiver
After=network.target

[Service]
Type=simple
ExecStart=/home/carter/.local/bin/dependabot-webhook
EnvironmentFile=/home/carter/.config/dependabot-webhook/env
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
