[Unit]
Description=Pi Web UI for omp coding agent
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/dev/pi-web
ExecStart=%h/.bun/bin/bun %h/dev/pi-web/bin/pi-web.js --hostname 127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
# Cap memory: a 2026-07-31 spike to 13.5GB anon-RSS OOM-killed the host
# (traefik + apache2 collateral). OOMPolicy=kill SIGKILLs the cgroup and
# Restart=on-failure recovers the service, containing the blast radius.
MemoryMax=4G
OOMPolicy=kill

[Install]
WantedBy=default.target
